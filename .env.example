# EcoSync Environmental Intelligence Platform Configuration

# Flask Core
FLASK_APP=app.py
FLASK_DEBUG=0
PORT=5000
ECOSYNC_SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars

# Computer Vision / YOLO Model Checkpoint
# Default is 'yolo11n.pt' (official pretrained weights automatically managed in models/)
ECOSYNC_YOLO_MODEL=yolo11n.pt

# Optional: Google Gemini API Key for Enhanced Generative Advisory Synthesis
# (Leave blank for 100% offline deterministic circular economy rules engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
